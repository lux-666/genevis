# Gene Agent LLM configuration
# Copy this to .env and fill in the real values.
# Assembly parameter recommendation requires a working LLM endpoint. Review
# timeout automation uses it only when an eligible automatic resolver is active.

GENE_AGENT_LLM_PROVIDER=openai_compatible
GENE_AGENT_LLM_MODEL=gpt-4o
GENE_AGENT_LLM_API_KEY=sk-...
GENE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
GENE_AGENT_LLM_TEMPERATURE=0.0
GENE_AGENT_LLM_MAX_TOKENS=4096
GENE_AGENT_LLM_TIMEOUT_SECONDS=120
