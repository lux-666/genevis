# ============================================================
#  HPC Integration Test Configuration
#  Copy this file to hpc_env.sh and fill in YOUR paths.
# ============================================================

# ---- Project root (auto-detected from script location) ----
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# ---- Tool environments ----
# Tool environments are resolved from ${PROJECT_ROOT}/config/envs.local.yaml
# when it exists, otherwise config/envs.yaml. Copy the shared file to the
# ignored local file and set its method/stage entries to this HPC's conda_env
# or conda_prefix values; do not add a second mapping here.

# ---- Test data paths ----
# Only LONG_READS is required.  Genome survey uses them directly when short
# reads are absent; SHORT_DNA takes precedence when supplied.  Add Hi-C for
# real scaffolding coverage.

# ONT or PacBio CLR long reads (FASTQ/FASTA, gzipped ok).  Space-separated for multiple files.
LONG_READS="/path/to/long_reads.fq.gz"

# Optional Illumina short DNA reads (paired, gzipped). When set, test_03
# prefers these over long reads for k-mer survey.
SHORT_DNA_R1=""
SHORT_DNA_R2=""

# Hi-C reads (paired, gzipped).  Space-separated R1 R2.
HIC_R1="/path/to/hic_R1.fq.gz"
HIC_R2="/path/to/hic_R2.fq.gz"

# ---- Biological parameters ----
GENOME_SIZE_ESTIMATE=""           # optional bp override; survey still runs when reads exist
PLATFORM="ont"                    # ont | clr | pacbio_hifi | cycloneseq
SAMPLE_ID="hpc_test_sample"
SPECIES="Danio rerio"             # for related-species sanity check

# Optional explicit assembly for test_05 / test_06.  Set this to the longer
# assembly you want to review; when empty, the tests search successful test_04
# session artifacts.
REVIEW_ASSEMBLY=""

# Optional real-data inputs for test_07. Set both to execute the local T2T
# stage; leave both empty for an explicit SKIP (exit 77), not a schema-only
# PASS. The reads may be FASTA/FASTQ and may be gzip-compressed.
T2T_ASSEMBLY=""
T2T_ONT_READS=""

# Directory holding the pinned NCBI Metazoa snapshot on this HPC.  It must
# contain Metazoa.ncbi.tsv and Metazoa.ncbi.lineage; the test copies them into
# data/reference/ncbi_metazoa and validates them against the tracked manifest.
NCBI_REFERENCE_SOURCE_DIR=""

# ---- Assembly method ----
# Recommended primary coverage:
#   pacbio_hifi -> ASSEMBLY_METHOD=hifiasm
#   ont/cycloneseq -> ASSEMBLY_METHOD=hifiasm_ont
# Flye and NextDenovo are kept as lighter smoke paths while the hifiasm
# parameter-recommendation loop is the main HPC target.
#
# These HPC tests do not enable catalog-default fallback. The LLM/provider
# configuration must be genuinely usable when testing the recommendation flow.
ASSEMBLY_METHOD="hifiasm_ont"      # hifiasm | hifiasm_ont | flye | nextdenovo
FLYE_READ_TYPE="nano-raw"          # used only when ASSEMBLY_METHOD=flye
ASSEMBLY_THREADS=8

# ---- BUSCO lineage ----
BUSCO_LINEAGE_PATH="/db/busco/actinopterygii_odb10"
BUSCO_LINEAGE_NAME="actinopterygii_odb10"

# ---- Hi-C scaffolding ----
HIC_RESTRICTION_ENZYME="DpnII"
HIC_CHROMOSOME_COUNT=25
# Optional: Juicer installation root that contains common/chimeric_sam.awk.
# For the upstream CPU layout, this is usually /path/to/juicer/CPU.
# Leave empty to auto-detect from the configured conda env and juicer.sh location.
HIC_JUICER_SCRIPTS_DIR=""
# Path to chrom.sizes file (required for Juicer+3D-DNA execution).
# If empty, Hi-C scaffolding will be planned but not executed.
# You can generate one from your assembly:
#   samtools faidx assembly.fasta && cut -f1,2 assembly.fasta.fai > chrom.sizes
HIC_CHROM_SIZES=""

# ---- Test output root ----
# All test sessions will be created under this directory.
TEST_DATA_ROOT="${PROJECT_ROOT}/data_hpc_test"

# ---- Checkpointer ----
CHECKPOINTER="sqlite"

# ---- Run unit tests first? (true/false) ----
RUN_UNIT_TESTS=true

# ---- Phase 11 parameter approval ----
# "manual" preserves every production human gate. run_all reports a blocked
# smoke as SKIP (77), prints its session ID, and continues independent tests.
# "approve" only auto-approves hash-bound assembly parameter recommendations;
# it never silently accepts assembly-review, Hi-C, or T2T biological decisions.
HPC_PARAMETER_APPROVAL_MODE="manual"   # manual | approve
HPC_MAX_PARAMETER_APPROVALS=3

# ---- Optional Read-QC length-filter coverage ----
# test_02 uses this executable subgraph instead of only the default skip path.
READ_QC_MIN_LEN=1000

# ---- Test 09 assembly-focused smoke (skip expensive upstream stages) ----
# true: skip read_qc + genome_survey; assembly uses raw long reads and
# GENOME_SIZE_ESTIMATE from shared_parameters. Full e2e should leave this false.
TEST09_SKIP_UPSTREAM=false
