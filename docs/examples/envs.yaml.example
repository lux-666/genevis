# Stage- and method-specific conda environment mapping for real local
# execution. Method-level entries override stage-level entries, which in turn
# override the default fallback.
#
# SETUP INSTRUCTIONS:
# 1. Either edit a machine-local config/envs.yaml manually or run
#    `gene-agent bootstrap` as an optional assistant.
# 2. Database and AutoHiC groups may be omitted until their resources are
#    installed. Omit all of `databases` for the former; for the latter omit the
#    four package entries and `methods.hic_scaffolding.candidate.autohic`.
# 3. After installing a skipped resource, add its complete group manually or
#    rerun ordinary bootstrap. Use --update to replace an existing managed
#    value. Database paths never enter RunConfig.
#
# Two mutually exclusive target forms are supported on any entry:
#   conda_env: env_geno_exec          # named env  → conda run -n env_geno_exec
#   conda_prefix: /opt/conda/envs/x   # abs path   → conda run -p /opt/conda/envs/x
# Using both on the same entry is rejected at load time.
#
# The default section likewise accepts either fallback_env or fallback_prefix
# (not both):
#   fallback_env: env_geno_exec
#   fallback_prefix: /opt/conda/envs/env_geno_exec
#
# Most bioinformatics tools (seqkit, flye, quast.py, ...)
# are expected to live in a single shared conda env. The `gene_agent` env is
# reserved for the orchestrator itself and is not a candidate host for tool binaries.

default:
  conda_bin: conda
  fallback_env: your_tool_env              # REPLACE: e.g., env_geno_exec
  # fallback_prefix: /path/to/your/env    # alternative: use abs path

# Host-owned databases. RunConfig never carries these paths or selects a BUSCO
# lineage. Assembly Review derives one installed lineage from the manifest NCBI
# scientific name; freeze validates and records the compact projection below.
databases:
  busco:
    # Registry/bootstrap compatibility default only; Assembly Review does not
    # fall back to it when species-based resolution fails.
    default_lineage: metazoa_odb10
    lineages:
      metazoa_odb10:
        path: /path/to/busco/metazoa_odb10
        version: odb10
        source: busco_downloads
      # Add every target-appropriate lineage that automatic selection may
      # resolve on this host, for example actinopterygii_odb10 for ray-finned fish.
  ncbi:
    # Root whose immediate children are snapshots such as metazoa/ and
    # viridiplantae/. Each child owns one same-prefix four-file NCBI export.
    reference_dir: /path/to/databases/ncbi

# AutoHiC, Juicer, and 3D-DNA are standalone git-clone
# installs, not conda-env PATH tools. Declare each as a top-level entry under
# `packages:` with `install_root` (absolute repo path) and `canary_paths`
# (files relative to install_root). Preflight validates root + canary by
# filesystem checks only — no PATH, no conda. `package_tools` on a method
# references these keys by name. Confirm `gene-agent bootstrap` once after
# filling to conform Juicer (build scripts -> CPU symlink, link in juicer_tools.jar).
#
# Tested versions:
#   Juicer: 1.6 (https://github.com/aidenlab/juicer)
#   3D-DNA: 180922 (https://github.com/aidenlab/3d-dna)
#   juicer_tools: 1.22.01 (https://github.com/aidenlab/juicer/wiki/Download)
packages:
  autohic:
    install_root: /path/to/AutoHiC         # REPLACE: AutoHiC repo root
    models:
      error: /path/to/error_model.pth      # REPLACE: AutoHiC error model
      chromosome: /path/to/chr_model.pth   # REPLACE: AutoHiC chromosome model
    entrypoints:
      - autohic.py
    canary_paths:
      - autohic.py
      - src/common/run.sh
      - src/models/cfgs/error_model.py
  juicer:
    install_root: /path/to/juicer          # REPLACE: repo root containing CPU/ and misc/
    conform_on_bootstrap: true             # bootstrap builds scripts/ and links the jar
    jar_root_ref: juicer_tools             # whose install_root supplies juicer_tools.jar
    entrypoints:
      - CPU/juicer.sh
    canary_paths:
      - CPU/juicer.sh
      - CPU/common/chimeric_blacklist.awk  # Juicer 1.6+ renamed from chimeric_sam.awk
      - misc/generate_site_positions.py
      - scripts/common/juicer_tools.jar    # bootstrap deploys this symlink
  three_d_dna:
    install_root: /path/to/3d-dna          # REPLACE: repo root
    entrypoints:
      - run-asm-pipeline.sh
      - run-asm-pipeline-post-review.sh
    canary_paths:
      - run-asm-pipeline.sh
      - run-asm-pipeline-post-review.sh
      - edit/apply-edits-prep-for-next-round.sh
      - visualize/run-assembly-visualizer.sh
  juicer_tools:
    install_root: /path/to/juicer_tools    # REPLACE: directory containing juicer_tools.jar v1.22.01
    canary_paths:
      - juicer_tools.jar

stages:
  read_qc:
    conda_env: your_tool_env               # REPLACE or omit to use default fallback
  genome_survey:
    conda_env: your_tool_env
  assembly:
    conda_env: your_tool_env
  assembly_dedup:
    conda_env: your_tool_env
  assembly_review:
    conda_env: your_tool_env
  hic_scaffolding:
    conda_env: your_tool_env
  t2t:
    conda_env: your_tool_env

methods:
  base_polish.racon:
    conda_env: your_tool_env
    required_tools:
      - minimap2
      - racon
  gapcloser.tgs_gapcloser:
    conda_env: your_tool_env
    # TGS-GapCloser 1.2.1; getopt must be the GNU implementation.
    required_tools:
      - tgsgapcloser
      - minimap2
      - getopt
  read_qc.long_read_stats.seqkit_stats:
    conda_env: your_tool_env
    required_tools:
      - seqkit
  read_qc.length_filter.seqkit_seq:
    conda_env: your_tool_env
    required_tools:
      - seqkit
  genome_survey.kmer_count.jellyfish:
    conda_env: your_tool_env
    # Executable name only. Its Conda package is Bioconda `kmer-jellyfish`;
    # conda-forge `jellyfish` is an unrelated Python string-matching library.
    required_tools:
      - jellyfish
      - gzip
  genome_survey.model.genomescope2:
    conda_env: your_tool_env
    required_tools:
      - genomescope2
  # Assembly method identity is selected at Assembly stage entry, not copied
  # from each RunConfig. Keep a non-empty required_tools/package_tools contract
  # for every candidate that a run may select; bootstrap checks this declared
  # catalog and the selected candidate is checked again from the frozen snapshot.
  assembly.candidate.flye:
    conda_env: your_tool_env
    required_tools:
      - flye
  assembly.candidate.nextdenovo:
    conda_env: your_tool_env
    required_tools:
      - nextDenovo
  assembly.candidate.hifiasm:
    conda_env: your_tool_env
    required_tools:
      - hifiasm
  assembly.candidate.hifiasm_ont:
    conda_env: your_tool_env
    required_tools:
      - hifiasm
  assembly_dedup.purge_dups:
    conda_env: your_tool_env
    required_tools:
      - minimap2
      - pbcstat
      - calcuts
      - split_fa
      - gzip
      - purge_dups
      - get_seqs
  assembly_review.eval.quast:
    conda_env: your_tool_env
    required_tools:
      - quast.py
  assembly_review.eval.busco:
    conda_env: your_tool_env
    required_tools:
      - busco
  hic_scaffolding.candidate.autohic:
    conda_env: autohic                     # AutoHiC's dedicated conda env
    required_tools:
      - python3.9
      - bwa
      - java
      - quast.py
    package_tools:
      - autohic
      - juicer
      - three_d_dna
  t2t.alignment.minimap2:
    conda_env: your_tool_env
    required_tools:
      - minimap2
