{
  "local_exec": ["read_qc", "assembly", "assembly_review", "repeat_annotation"],
  "shared_parameters": {
    "read_type": "ont_raw",
    "estimated_genome_size": 5000000
  },
  "assembly": {
    "flye_parameters": {
      "threads": 4
    }
  },
  "assembly_review": {
    "quast": {
      "threads": 4
    }
  },
  "review_policy": {
    "mode": "strict"
  },
  "function_annotation": {
