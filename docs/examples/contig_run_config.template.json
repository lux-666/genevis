{
  "requested_stages": [
    {
      "stage": "read_qc",
      "allow_local_execution": true
    },
    {
      "stage": "genome_survey",
      "allow_local_execution": true
    },
    {
      "stage": "assembly",
      "allow_local_execution": true
    },
    {
      "stage": "assembly_dedup",
      "allow_local_execution": true
    },
    {
      "stage": "assembly_review",
      "allow_local_execution": true
    }
  ],

  "review_policy": {
    "max_blocked_seconds": 300
  },

  "genome_survey": {
    "survey_parameters": {
      "kmer_size": 21,
      "hash_size": "1G",
      "threads": 8
    }
  },

  "assembly_dedup": {
    "automatic_purge_approved": true,
    "threads": 8,
    "get_seqs_exclude_haplotigs": true
  },

  "assembly_review": {
    "quast": {
      "threads": 8
    },
    "busco": {
      "threads": 8
    }
  }
}
