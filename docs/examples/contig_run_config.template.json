{
  "requested_stages": [
    {
      "stage": "read_qc",
      "allow_local_execution": true
    },
    {
      "stage": "genome_survey",
      "allow_local_execution": true
    },
    {
      "stage": "assembly",
      "allow_local_execution": true
    },
    {
      "stage": "assembly_dedup",
      "allow_local_execution": true
    },
    {
      "stage": "assembly_review",
      "allow_local_execution": true
    }
  ],

  "review_policy": {
    "max_blocked_seconds": 300,
    "stages": {
      "assembly_review": {
        "max_blocked_seconds": -1
      }
    }
  },

  "shared_parameters": {
    "platform": "cycloneseq",
    "read_type": "cyclone"
  },

  "genome_survey": {
    "survey_parameters": {
      "kmer_size": 21,
      "hash_size": "1G",
      "threads": 8
    }
  },

  "assembly": {
    "assembly_method": "flye",
    "assembly_route": "cyclone",
    "flye_parameters": {
      "threads": 8
    }
  },

  "assembly_review": {
    "quast": {
      "threads": 8
    },
    "busco": {
      "lineage_path": "/absolute/path/to/busco_downloads/lineages/insecta_odb10",
      "lineage_name": "insecta_odb10",
      "lineage_version": "odb10",
      "lineage_source": "local",
      "mode": "genome",
      "threads": 8
    }
  }
}
